#env
.env
.env.*
# .env.production não tem segredo nenhum (só VITE_API_URL="") - é config de
# build necessária pra gerar o bundle certo em produção, precisa ser versionada.
!.env.production

# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local
*.tsbuildinfo

# Arquivos enviados por usuários (uploads de anexos em tickets) - dado de
# runtime, não código-fonte, não deve ser versionado.
server/uploads

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

.env

# Credenciais reais (senhas, tokens) - nunca versionar
CREDENTIALS.md
