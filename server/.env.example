# Arquivo de exemplo - copie para .env e preencha com valores reais

# Banco de dados (PostgreSQL)
DATABASE_URL="postgresql://usuario:senha@localhost:5432/unasystickets"

# Servidor
PORT=3001
NODE_ENV=development
# URL publica da API (usada em links de email etc.)
API_PUBLIC_URL="http://localhost:3001"
# URL do frontend (para CORS e links em email)
APP_PUBLIC_URL="http://localhost:5173"

# JWT
JWT_ACCESS_SECRET="troque-este-valor-por-uma-string-aleatoria-longa"
JWT_REFRESH_SECRET="troque-este-outro-valor-tambem-aleatorio-e-longo"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# Uploads
UPLOAD_DIR="./uploads"
MAX_UPLOAD_MB=25

# Se definido, o Express também serve o build do frontend (dist/ do Vite)
# nesse caminho, com fallback de SPA. Deixe em branco em desenvolvimento
# (o frontend roda separado, via `npm run dev` na raiz do projeto).
FRONTEND_DIST_DIR=""

# Webhook token compartilhado - usado por
# consultarStatusTicket / receiveSalesData (CRM Unasys Flow) e por
# metabotWebhook (configure o mesmo valor no cadastro do webhook no Metabot)
WEBHOOK_SECRET_TOKEN="defina-um-token-longo-compartilhado-com-o-crm-e-metabot"
# Endpoint do CRM que recebe atualização de status de ticket (updateTicketStatus)
FLOW_SYNC_URL=""

# Gmail (fase 3 - integracao de e-mail)
GMAIL_CLIENT_ID=""
GMAIL_CLIENT_SECRET=""
GMAIL_REFRESH_TOKEN=""
GMAIL_SENDER_EMAIL="projetos@unasyshub.com.br"

# Metabot / WhatsApp (fase 3)
METABOT_API_TOKEN=""

# Notion (fase 7 - opcional, junto com IA)
NOTION_TOKEN=""

# LLM (fase 7 - opcional, adiado)
# ANTHROPIC_API_KEY=""
