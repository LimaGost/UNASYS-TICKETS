  notion_page_id     String?
  notion_url         String?
  last_synced        DateTime?
  created_date       DateTime  @default(now())
  updated_date       DateTime  @updatedAt

  @@index([vertical])
  @@index([notion_page_id])
  @@map("knowledge_articles")
}

model KnowledgeCategory {
  id            String   @id @default(uuid()) @db.Char(36)
  name          String
  description   String?  @db.Text
  vertical      String
  color         String?  @default("#8B5CF6")
  icon          String?
  order         Int      @default(0)
  active        Boolean  @default(true)
  created_date  DateTime @default(now())
  updated_date  DateTime @updatedAt

  @@index([vertical])
  @@map("knowledge_categories")
}

model ResponseTemplate {
  id            String   @id @default(uuid()) @db.Char(36)
  name          String
  category      String?
  subject       String?
  content       String   @db.Text
  tags          Json?
  vertical      String?
  main_type     String   @default("geral")
  usage_count   Int      @default(0)
  active        Boolean  @default(true)
  created_date  DateTime @default(now())
  updated_date  DateTime @updatedAt

  @@index([vertical])
  @@map("response_templates")
}

model QuickLink {
  id            String   @id @default(uuid()) @db.Char(36)
  title         String
  url           String
  description   String?
  category      String?
  vertical      String?
  icon          String?
  active        Boolean  @default(true)
  created_date  DateTime @default(now())
  updated_date  DateTime @updatedAt

  @@index([vertical])
  @@map("quick_links")
}

model DailyRoutine {
  id                 String   @id @default(uuid()) @db.Char(36)
  title              String
  description        String?  @db.Text
  steps              Json?
  frequency          String   @default("diaria")
  category           String?
  vertical           String?
  responsible        String?
  estimated_minutes  Int?
  active             Boolean  @default(true)
  created_date       DateTime @default(now())
  updated_date       DateTime @updatedAt

  @@index([vertical])
  @@map("daily_routines")
}

// ────────────────────────────────────────────────────────────────────────
// Configuração de negócio
