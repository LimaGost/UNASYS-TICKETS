model ServiceType {
  id            String   @id @default(uuid()) @db.Char(36)
  name          String
  ticket_type   String?
  vertical      String
  active        Boolean  @default(true)
  created_date  DateTime @default(now())
  updated_date  DateTime @updatedAt

  @@index([vertical])
  @@map("service_types")
}

model ServiceCategory {
  id            String   @id @default(uuid()) @db.Char(36)
  name          String
  color         String?
  vertical      String
  active        Boolean  @default(true)
  created_date  DateTime @default(now())
  updated_date  DateTime @updatedAt

  @@index([vertical])
  @@map("service_categories")
}

model ServiceFormConfig {
  id            String   @id @default(uuid()) @db.Char(36)
  service_type  String
  vertical      String
  fields_config Json
  active        Boolean  @default(true)
  created_date  DateTime @default(now())
  updated_date  DateTime @updatedAt

  @@index([vertical, service_type])
  @@map("service_form_configs")
}

model SuporteConfig {
  id                       String   @id @default(uuid()) @db.Char(36)
  vertical                 String
  default_sla_hours        Int      @default(24)
  urgent_sla_hours         Int      @default(4)
  critical_sla_hours       Int      @default(2)
  auto_assign_enabled      Boolean  @default(false)
  auto_assign_strategy     String   @default("round_robin")
  allowed_agents           Json?
  require_client_approval  Boolean  @default(false)
  enable_chat              Boolean  @default(false)
  enable_phone_support     Boolean  @default(true)
  business_hours_start     String   @default("08:00")
  business_hours_end       String   @default("18:00")
  work_days                Json?
  active                   Boolean  @default(true)
  created_date             DateTime @default(now())
  updated_date              DateTime @updatedAt

  @@index([vertical])
  @@map("suporte_configs")
}

model Vertical {
  id            String   @id @default(uuid()) @db.Char(36)
  name          String
  code          String   @unique
  description   String?  @db.Text
  color         String?  @default("#8B5CF6")
  active        Boolean  @default(true)
  created_date  DateTime @default(now())
  updated_date  DateTime @updatedAt

  @@map("verticals")
}

model SystemConfig {
  id            String   @id @default(uuid()) @db.Char(36)
  key           String   @unique
  value         String   @db.Text
  label         String?
  created_date  DateTime @default(now())
  updated_date  DateTime @updatedAt

  @@map("system_configs")
}

model SyncState {
  id            String   @id @default(uuid()) @db.Char(36)
  key           String   @unique
  history_id    String
  created_date  DateTime @default(now())
  updated_date  DateTime @updatedAt

  @@map("sync_states")
}

// ────────────────────────────────────────────────────────────────────────
// Agenda / Horas
// ────────────────────────────────────────────────────────────────────────

model Appointment {
  id            String   @id @default(uuid()) @db.Char(36)
  title         String
  description   String?  @db.Text
  date          DateTime @db.Date
  start_time    String?
  end_time      String?
  vertical      String
  type          String   @default("reuniao")
  client_id     String?
  client_name   String?
  ticket_id     String?
  ticket_title  String?
  attendees     Json?
  owner_email   String?
  owner_name    String?
  color         String?  @default("#8B5CF6")
  created_date  DateTime @default(now())
  updated_date  DateTime @updatedAt

  @@index([owner_email])
  @@index([vertical])
  @@map("appointments")
}

// ────────────────────────────────────────────────────────────────────────
// WhatsApp / Metabot
// ────────────────────────────────────────────────────────────────────────

model WhatsAppAtendimentoVinculado {
  id                 String    @id @default(uuid()) @db.Char(36)
  implantacao_id     String
  implantacao_nome   String?
  attendance_id      String
  contact_name       String
  contact_number     String?
  messages_count     Int       @default(0)
  ticket_id          String?
  hours_logged       Float     @default(0)
  status             String    @default("ativo")
  finalized_at       DateTime?
  notes              String?   @db.Text
  analyst_email      String?
  created_date       DateTime  @default(now())
  updated_date       DateTime  @updatedAt

  @@index([implantacao_id])
  @@index([attendance_id])
  @@index([analyst_email])
  @@map("whatsapp_atendimentos_vinculados")
}
